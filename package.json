{
  "name": "dsh-py-codeact",
  "version": "0.3.6",
  "description": "CodeAct agent loop for the DeepSeek Harness: a persistent IPython session as the model's action space, with harness tools bridged in as a virtual `__dsh__.tools` module.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNSeniorious000/dsh-py-codeact.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis-plugin",
    "codeact",
    "agent",
    "python",
    "ipython",
    "repl",
    "mcp"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "py",
    "example",
    "cordis.patch.yml",
    "!**/__pycache__"
  ],
  "scripts": {
    "test": "node test/smoke.js && node test/client-render.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 || >=4.0.5-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-tool": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1"
  }
}
