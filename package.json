{
  "name": "dsh-py-codeact",
  "version": "0.5.0",
  "description": "CodeAct agent loop for the DeepSeek Harness: a persistent IPython session as the model's action space, with harness tools bridged in as a virtual `__dsh__.tools` module.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNSeniorious000/dsh-py-codeact.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis-plugin",
    "codeact",
    "agent",
    "python",
    "ipython",
    "repl",
    "mcp"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./settings": "./lib/settings.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "py",
    "example",
    "cordis.patch.yml",
    "!**/__pycache__"
  ],
  "scripts": {
    "test": "node test/smoke.js && node test/client-render.js && node --test test/settings.test.js test/subcall-scheduler.test.js && node test/execution-policy.js && node test/review-regressions.js && node test/renderer-loading.js",
    "test:streaming": "node --test test/code-deltas.test.js test/python-streams.test.js test/streaming-recovery.test.js test/subcall-scheduler.test.js && node test/streaming.js && node test/streaming-lifecycle.js && node test/streaming-settings.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5",
    "@deepseek-ai/cordis": ">=4.0.1 || >=4.0.5-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "react": ">=18",
    "@deepseek-ai/dsh-scope": ">=0.1.1-rc.2 || >=0.1.2-0 || >=0.1.3-0 || >=0.1.5-0 || >=0.1.6-0 || >=0.1.7-0 || >=0.2.0-0 || >=0.2.1-0 || >=0.2.2-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.2 || >=0.2.2-0",
    "@deepseek-ai/dsh-tool-executor-ptc": ">=0.2.2-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 || >=0.2.2-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.2 || >=0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-tool": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-executor-ptc": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
